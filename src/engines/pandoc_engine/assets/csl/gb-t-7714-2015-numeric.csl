<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="zh-CN">
  <info>
    <title>GB/T 7714-2015 Numeric (Minimal)</title>
    <id>https://document-conversion.local/styles/gb-t-7714-2015-numeric-minimal</id>
    <link href="https://document-conversion.local/styles/gb-t-7714-2015-numeric-minimal" rel="self"/>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Minimal bundled numeric CSL style used by the pandoc engine.</summary>
    <updated>2026-03-28T00:00:00+08:00</updated>
  </info>
  <locale xml:lang="zh-CN">
    <terms>
      <term name="edition" form="short">版</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " initialize-with=""/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="title">
    <text variable="title"/>
  </macro>
  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="issued"/>
      </group>
    </layout>
  </bibliography>
</style>
