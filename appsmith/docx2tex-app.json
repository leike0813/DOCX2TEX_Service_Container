        },
        "pageId": "Docx2Tex",
        "actionConfiguration": {
          "timeoutInMillisecond": 15000,
          "paginationType": "NONE",
          "body": "\nexport default {\n  async createAndPoll() {\n    await storeValue(\"lastPoll\", null);\n    await storeValue(\"currentTaskId\", null);\n    await storeValue(\"isPolling\", true);\n    try {\n      await CreateTask.run();\n      const taskId = CreateTask.data?.task_id;\n      if (!taskId) {\n        throw new Error(\"Task creation failed (no task id returned)\");\n      }\n      await storeValue(\"currentTaskId\", taskId);\n      return await this.pollTask(taskId);\n    } catch (error) {\n      await storeValue(\"isPolling\", false);\n      throw error;\n    }\n  },\n\n  async pollTask(taskId) {\n    if (!taskId) {\n      throw new Error(\"Missing task id for polling\");\n    }\n    const maxAttempts = 60;\n    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n    for (let attempt = 0; attempt < maxAttempts; attempt += 1) {\n      await PollTaskStatus.run();\n      await storeValue(\"lastPoll\", PollTaskStatus.data);\n      const state = PollTaskStatus.data?.data?.state;\n      if (state === \"done\") {\n        await storeValue(\"isPolling\", false);\n        return PollTaskStatus.data;\n      }\n      if (state === \"failed\") {\n        await storeValue(\"isPolling\", false);\n        throw new Error(PollTaskStatus.data?.data?.err_msg || \"docx2tex task failed\");\n      }\n      await delay(2500);\n    }\n    await storeValue(\"isPolling\", false);\n    throw new Error(\"Timeout waiting for docx2tex task\");\n  },\n};\n",
          "selfReferencingDataPaths": [],
          "jsArguments": []
        },
