    {
      "id": "Docx2Tex_TaskManager",
      "pluginType": "JS",
      "pluginId": "js-plugin",
      "unpublishedAction": {
        "name": "TaskManager",
        "fullyQualifiedName": "TaskManager",
        "datasource": {
          "name": "UNUSED_JS",
          "pluginId": "js-plugin",
          "messages": [],
          "isAutoGenerated": false,
          "deleted": false,
          "policies": [],
